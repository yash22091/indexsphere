{
  "name": "indexsphere",
  "version": "1.0.0",
  "private": true,
  "author": "Yash Patel",
  "description": "Modern Elasticsearch & OpenSearch Web Admin Tool",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:production": "NODE_ENV=production next build",
    "start:production": "NODE_ENV=production next start",
    "docker:build": "docker build -t indexsphere-web .",
    "docker:build:minimal": "docker build -f Dockerfile.minimal -t indexsphere:minimal .",
    "docker:run": "docker run -p 3000:3000 indexsphere-web",
    "docker:compose": "docker-compose up -d",
    "docker:compose:prod": "docker-compose -f docker-compose.prod.yml --env-file .env.production up -d",
    "docker:compose:down": "docker-compose down",
    "health": "curl -f http://localhost:3000/api/health || exit 1",
    "test:health": "npm run health",
    "deploy:prepare": "npm run lint && npm run build:production",
    "deploy:prod": "bash deploy-production.sh",
    "k8s:deploy": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/",
    "k8s:status": "kubectl get pods -n indexsphere"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.16.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.4.3",
    "lucide-react": "^0.525.0",
    "next": "15.4.3",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.2",
    "puppeteer": "^22.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
