{
  "name": "indexsphere",
  "version": "1.0.0",
  "private": true,
  "author": "Yash Patel",
  "description": "Modern Elasticsearch & OpenSearch Web Admin Tool",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "build:production": "NODE_ENV=production next build",
    "start:production": "NODE_ENV=production next start",
    "health": "curl -f http://localhost:3000/api/health || exit 1",
    "test:health": "npm run health",
    "deploy:prepare": "npm run typecheck && npm test && npm run build:production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "docker:build": "docker build -f Dockerfile.production -t indexsphere:latest .",
    "docker:up": "docker compose -f docker-compose.nginx.yml up -d",
    "docker:down": "docker compose -f docker-compose.nginx.yml down"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.16",
    "puppeteer": "^25.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
