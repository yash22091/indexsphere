*.tgz

# Yarn Integrity file
.yarn-integrity

# Database files
*.db
*.sqlite
*.sqlite3

# Backup files
*.backup
*.bak

# Temporary files
tmp/
temp/

# Application data (keep structure but ignore content)
data/*.json
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# TLS certificates (never commit private keys)
certs/*.pem
certs/*.key
certs/*.crt
certs/*.cert

# Local SQLite database (users, encrypted connection passwords)
data/*.db
data/*.db-*
