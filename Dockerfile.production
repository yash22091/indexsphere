# Multi-stage build for production optimization
# Node 22 LTS (Node 18 is end-of-life and no longer receives security fixes)
FROM node:22-alpine AS base

# ── deps: install ALL dependencies (including devDeps for native module compilation) ──
FROM base AS deps
# libc6-compat for glibc shims; python3/make/g++ compile better-sqlite3 native addon
RUN apk add --no-cache libc6-compat python3 make g++ sqlite-dev

WORKDIR /app
COPY package.json package-lock.json* ./
# The image uses Alpine's Chromium for PDFs, so skip Puppeteer's ~170 MB Chrome download
ENV PUPPETEER_SKIP_DOWNLOAD=true
# Compile native addons against the headers shipped in this image (no header download needed)
ENV npm_config_nodedir=/usr/local
# Full install (devDeps needed for TS build + native addon compilation: better-sqlite3, bcrypt)
RUN npm ci && npm cache clean --force

# ── builder: compile TypeScript / Next.js ────────────────────────────────────
FROM base AS builder
RUN apk add --no-cache python3 make g++ sqlite-dev
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json* ./
COPY src/            ./src/
COPY public/         ./public/
COPY next.config.ts  ./
COPY tsconfig.json   ./
COPY postcss.config.mjs ./
COPY components.json ./
COPY next-env.d.ts   ./
COPY indexsphere.production.json ./indexsphere.json

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN npm run build

# ── runner: lean production image ────────────────────────────────────────────
FROM base AS runner
WORKDIR /app

# chromium+friends for Puppeteer PDF; sqlite-libs for better-sqlite3 native addon
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    sqlite-libs \
    && rm -rf /var/cache/apk/* /tmp/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV NODE_ENV=production
# Cap the V8 heap: keeps memory predictable in containers (tested flat under sustained load).
# Container needs ~1 GB total: Node (heap + ~150 MB) plus up to PDF_MAX_CONCURRENCY Chromium instances (~200 MB each)
ENV NODE_OPTIONS=--max-old-space-size=384
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

RUN mkdir -p /app/data && chown nextjs:nodejs /app/data

COPY --from=builder /app/public                                ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static    ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/indexsphere.json ./indexsphere.json

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
